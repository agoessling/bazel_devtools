load("@bazel_binaries//:defs.bzl", "bazel_binaries")
load(
    "@rules_bazel_integration_test//bazel_integration_test:defs.bzl",
    "bazel_integration_test",
)

package(default_visibility = ["//visibility:public"])

alias(
    name = "ide-sync",
    actual = "//tools:ide_sync",
)

exports_files([
    ".bazel_devtools/basedpyright.json",
    ".bazel_devtools/biome.json",
    ".bazel_devtools/ruff.toml",
    ".bazel_devtools/tsconfig.json",
    ".github/workflows/ci.yml",
    ".pre-commit-config.yaml",
    ".ruff.toml",
    "LICENSE",
    "MODULE.bazel",
    "REPO.bazel",
    "README.md",
    "basedpyright.json",
    "biome.json",
    "multitool.lock.json",
    "requirements.in",
    "requirements_lock.txt",
    "tsconfig.json",
])

filegroup(
    name = "distribution_files",
    srcs = glob([
        ".*",
        ".bazel_devtools/**",
        "*",
    ]) + [
        "//checks:distribution_files",
        "//e2e:distribution_files",
        "//third_party/aspect_rules_lint:distribution_files",
        "//tools:distribution_files",
    ],
)

# This child module is intentionally hidden from the parent module by
# .bazelignore. Keep its committed fixture inputs explicit so integration tests
# can still materialize it without treating its BUILD files as parent targets.
filegroup(
    name = "polyglot_workspace_files",
    srcs = [
        "examples/polyglot/.bazel_devtools/basedpyright.json",
        "examples/polyglot/.bazel_devtools/biome.json",
        "examples/polyglot/.bazel_devtools/ruff.toml",
        "examples/polyglot/.bazel_devtools/state.json",
        "examples/polyglot/.bazel_devtools/tsconfig.json",
        "examples/polyglot/.github/workflows/bazel-devtools.yml",
        "examples/polyglot/.pre-commit-config.yaml",
        "examples/polyglot/.bazelrc",
        "examples/polyglot/.bazelrc.bazel_devtools",
        "examples/polyglot/.bazelversion",
        "examples/polyglot/.bazelignore",
        "examples/polyglot/.clang-format",
        "examples/polyglot/.clang-tidy",
        "examples/polyglot/.gitignore",
        "examples/polyglot/.ruff.toml",
        "examples/polyglot/BUILD.bazel",
        "examples/polyglot/MODULE.bazel",
        "examples/polyglot/MODULE.bazel.lock",
        "examples/polyglot/REPO.bazel",
        "examples/polyglot/basedpyright.json",
        "examples/polyglot/cpp/BUILD.bazel",
        "examples/polyglot/cpp/greeting.cc",
        "examples/polyglot/cpp/greeting.h",
        "examples/polyglot/cpp/greeting_test.cc",
        "examples/polyglot/cpp_context/BUILD.bazel",
        "examples/polyglot/cpp_context/context_helper.h",
        "examples/polyglot/cpp_context/current_repository.cc",
        "examples/polyglot/cpp_context/current_repository.h",
        "examples/polyglot/cpp_transition/BUILD.bazel",
        "examples/polyglot/cpp_transition/configured.c",
        "examples/polyglot/cpp_transition/defs.bzl",
        "examples/polyglot/external_cpp_fixture/BUILD.bazel",
        "examples/polyglot/external_cpp_fixture/MODULE.bazel",
        "examples/polyglot/external_cpp_fixture/vendor_policy.h",
        "examples/polyglot/first_party_api/BUILD.bazel",
        "examples/polyglot/first_party_api/__init__.py",
        "examples/polyglot/import_order/BUILD.bazel",
        "examples/polyglot/import_order/import_order_contract.py",
        "examples/polyglot/biome.json",
        "examples/polyglot/package.json",
        "examples/polyglot/pnpm-lock.yaml",
        "examples/polyglot/pnpm-workspace.yaml",
        "examples/polyglot/python/BUILD.bazel",
        "examples/polyglot/python/greeting.py",
        "examples/polyglot/python/greeting_test.py",
        "examples/polyglot/python/manual_contract_test.py",
        "examples/polyglot/rust/BUILD.bazel",
        "examples/polyglot/rust/greeting.rs",
        "examples/polyglot/rust/greeting_test.rs",
        "examples/polyglot/rustfmt.toml",
        "examples/polyglot/tools/bazel_devtools/BUILD.bazel",
        "examples/polyglot/tools/bazel_devtools/aspects.bzl",
        "examples/polyglot/tsconfig.json",
        "examples/polyglot/typescript/BUILD.bazel",
        "examples/polyglot/typescript/greeting.ts",
        "examples/polyglot/typescript/greeting_view.tsx",
        "examples/polyglot/typescript/tsconfig.esbuild.json",
        "examples/polyglot/typescript/tsconfig.json",
        "examples/polyglot/third_party_api/BUILD.bazel",
        "examples/polyglot/third_party_api/__init__.py",
    ],
)

bazel_integration_test(
    name = "polyglot_integration_test",
    bazel_binaries = bazel_binaries,
    bazel_version = bazel_binaries.versions.current,
    data = [
        "@actionlint_linux_x86_64//:actionlint",
        "@bazel_binaries_bazelisk//:bazelisk",
        "@neovim_linux_x86_64//:bin/nvim",
        "@neovim_linux_x86_64//:dist",
    ],
    env = {
        "BAZEL_DEVTOOLS_ACTIONLINT": "$(rootpath @actionlint_linux_x86_64//:actionlint)",
        "BAZEL_DEVTOOLS_BAZELISK": "$(rootpath @bazel_binaries_bazelisk//:bazelisk)",
        "BAZEL_DEVTOOLS_NVIM": "$(rootpath @neovim_linux_x86_64//:bin/nvim)",
    },
    tags = [
        "exclusive",
        "manual",
    ],
    test_runner = "//e2e:integration_runner",
    workspace_files = [
        ":distribution_files",
        ":polyglot_workspace_files",
    ],
    workspace_path = "examples/polyglot",
)

test_suite(
    name = "fast_tests",
    tests = [
        "//tests/unit:bazel_support_test",
        "//tests/unit:bazel_wrapper_test",
        "//tests/unit:install_hooks_test",
        "//tests/unit:presubmit_config_test",
        "//tests/unit:setup_lib_test",
    ],
)

test_suite(
    name = "integration_tests",
    tags = ["manual"],
    tests = [":polyglot_integration_test"],
)

test_suite(
    name = "release_tests",
    tags = ["manual"],
    tests = [
        ":fast_tests",
        ":integration_tests",
    ],
)
