load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "basedpyright.bzl",
    "cpp.bzl",
    "defs.bzl",
    "format.bzl",
    "propagation.bzl",
    "python.bzl",
    "rust.bzl",
    "ruff.bzl",
    "typescript.bzl",
])

filegroup(
    name = "distribution_files",
    srcs = glob(["**"]),
)

bzl_library(
    name = "typescript",
    srcs = [
        "format.bzl",
        "propagation.bzl",
        "typescript.bzl",
    ],
)

bzl_library(
    name = "cpp",
    srcs = [
        "cpp.bzl",
        "format.bzl",
        "propagation.bzl",
    ],
    deps = [
        "//third_party/aspect_rules_lint:clang_tidy.bzl",
    ],
)

bzl_library(
    name = "python",
    srcs = [
        "basedpyright.bzl",
        "format.bzl",
        "python.bzl",
        "ruff.bzl",
    ],
    deps = [
        "@aspect_rules_lint//lint:ruff",
        "@rules_python//python:defs",
    ],
)

bzl_library(
    name = "rust",
    srcs = ["rust.bzl"],
    deps = [
        "@rules_rust//rust:defs.bzl",
    ],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        ":cpp",
        ":python",
        ":rust",
        ":typescript",
    ],
)
