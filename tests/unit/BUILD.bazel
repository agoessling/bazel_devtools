    deps = ["//tools:install-hooks"],
)

sh_test(
    name = "presubmit_config_test",
    srcs = ["presubmit_config_test.sh"],
    args = [
        "$(rootpath @actionlint_linux_x86_64//:actionlint)",
        "$(rootpath //tools:pre-commit)",
        "$(rootpath //:.pre-commit-config.yaml)",
        "$(rootpath //:.github/workflows/ci.yml)",
    ],
    data = [
        "//:.github/workflows/ci.yml",
        "//:.pre-commit-config.yaml",
        "//tools:pre-commit",
        "@actionlint_linux_x86_64//:actionlint",
    ],
)

