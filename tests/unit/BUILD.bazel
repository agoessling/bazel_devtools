load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

py_test(
    name = "bazel_support_test",
    srcs = ["bazel_support_test.py"],
    legacy_create_init = 0,
    deps = ["//tools:bazel_support"],
)

py_test(
    name = "bazel_wrapper_test",
    srcs = ["bazel_wrapper_test.py"],
    legacy_create_init = 0,
    deps = ["//tools:bazel_wrapper"],
)

py_test(
    name = "install_hooks_test",
    srcs = ["install_hooks_test.py"],
